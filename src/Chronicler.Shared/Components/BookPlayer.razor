@inject ApiClient Api
@inject NavigationManager Nav
@using Microsoft.AspNetCore.Components.Forms
@inject IServiceProvider Services
@using Microsoft.Extensions.DependencyInjection

@if (_book is null)
{
    <div class="loading">Consulting the archive...</div>
}
else
{
    <div class="book-player-page">
        <button class="btn-back" @onclick='() => Nav.NavigateTo("/archive")'>Library</button>

        <div class="book-header">
            <div class="cover-container">
                @if (_coverSrc is not null)
                {
                    <img class="book-cover-small" src="@_coverSrc" alt="@_book.Title"
                         @ontouchstart="OnCoverTouchStart" @ontouchend="OnCoverTouchEnd" @ontouchmove="OnCoverTouchEnd"
                         @onmousedown="OnCoverTouchStart" @onmouseup="OnCoverTouchEnd" @onmouseleave="OnCoverTouchEnd"
                         title="Long press to edit metadata" />
                }
                else
                {
                    <div class="book-cover-small-placeholder"
                         @ontouchstart="OnCoverTouchStart" @ontouchend="OnCoverTouchEnd" @ontouchmove="OnCoverTouchEnd"
                         @onmousedown="OnCoverTouchStart" @onmouseup="OnCoverTouchEnd" @onmouseleave="OnCoverTouchEnd"
                         title="Long press to edit metadata">
                        📚
                    </div>
                }
            </div>

            @if (_showMetaEditor)
            {
                <div class="meta-editor-overlay" @onclick="CloseMetaEditor">
                    <div class="meta-editor" @onclick:stopPropagation="true">
                        <h3 style="margin-bottom:.75rem;text-align:center">Edit Details</h3>
                        <label class="meta-label">Title</label>
                        <input class="form-input" @bind="_editTitle" />
                        <label class="meta-label">Author</label>
                        <input class="form-input" @bind="_editAuthor" />
                        <label class="meta-label">Narrator</label>
                        <input class="form-input" @bind="_editNarrator" placeholder="(optional)" />
                        <label class="meta-label">Year</label>
                        <input class="form-input" type="number" @bind="_editYear" placeholder="(optional)" />

                        <label class="meta-label" style="margin-top:.5rem">
                            Cover Image @(_book?.HasCover == true ? "(replaces existing)" : "")
                        </label>
                        <InputFile OnChange="OnCoverFileSelected" accept="image/*"
                                   style="color:var(--parchment-dim);font-size:.8rem;width:100%" />
                        @if (_pendingCoverName is not null)
                        {
                            <div style="font-size:.7rem;color:var(--verdigris);margin-top:.2rem">📎 @_pendingCoverName</div>
                        }

                        <div style="display:flex;gap:.5rem;margin-top:.75rem;justify-content:center">
                            <button class="btn-primary" @onclick="SaveMeta" disabled="@_savingMeta">
                                @(_savingMeta ? "⚙ Saving..." : "Save")
                            </button>
                            <button class="btn-secondary" @onclick="CloseMetaEditor">Cancel</button>
                        </div>
                    </div>
                </div>
            }
            <div class="book-info">
                <div class="book-title-main">@_book.Title</div>
            </div>
        </div>
        <div class="book-author-row">
            <span class="book-author-label">@_book.Author</span>
            @if (_book.Narrator is not null)
            {
                <span class="narrator"> · @_book.Narrator</span>
            }
        </div>

        @if (_currentChapter is not null)
        {
            <AudioPlayer @key="_currentChapter.Id"
                         Src="@Api.GetChapterAudioUrl(_currentChapter.Id)"
                         BookTitle="@_currentChapter.Title"
                         StartPosition="@_startPosition"
                         OnProgressChanged="SaveChapterProgress"
                         OnChapterEnded="AdvanceChapter" />
        }

        @if (_chapters.Count > 0)
        {
            <div class="chapter-list">
                <div class="chapter-list-header" style="display:flex;justify-content:space-between;align-items:center">
                    <h3>Chapters</h3>
                    @if (_downloadSvc is not null)
                    {
                        var allDownloaded = _downloadStates.Values.All(s => s == DownloadState.Downloaded);
                        var anyDownloaded = _downloadStates.Values.Any(s => s == DownloadState.Downloaded);
                        @if (!allDownloaded && !_downloadingAll)
                        {
                            <button class="btn-secondary" style="font-size:.65rem" @onclick="DownloadAll">⬇ All</button>
                        }
                        else if (_downloadingAll)
                        {
                            <span style="font-size:.65rem;color:var(--brass);font-style:italic">⚙ Downloading...</span>
                        }
                        else if (anyDownloaded)
                        {
                            <button class="btn-secondary" style="font-size:.65rem" @onclick="DeleteAllDownloads">✕ Remove all</button>
                        }
                    }
                </div>
                @foreach (var (chapter, progress) in _chapters.Zip(_chapterProgresses))
                {
                    var isCurrent = chapter.Id == _currentChapter?.Id;
                    var dlState = _downloadStates.GetValueOrDefault(chapter.Id, DownloadState.None);
                    <div class="chapter-item @(isCurrent ? "chapter-active" : "") @(progress.IsListened ? "chapter-listened" : "")"
                         @onclick="() => SelectChapter(chapter)">
                        <span class="chapter-number">@chapter.TrackNumber</span>
                        <span class="chapter-title">@chapter.Title</span>
                        <span class="chapter-status">
                            @if (progress.IsListened)
                            {
                                <span class="listened-badge" title="Listened">✓</span>
                            }
                            else if (progress.PositionSeconds > 0)
                            {
                                <span class="in-progress-badge" title="In progress">…</span>
                            }
                            @if (isCurrent)
                            {
                                <span class="playing-badge">▶</span>
                            }
                        </span>
                        @if (_downloadSvc is not null)
                        {
                            @if (dlState == DownloadState.Downloaded)
                            {
                                <span class="download-badge" title="Downloaded" @onclick:stopPropagation="true"
                                      @onclick="() => DeleteDownload(chapter.Id)">⬇✓</span>
                            }
                            else if (dlState == DownloadState.Downloading)
                            {
                                <span class="download-badge downloading" title="Downloading...">⏳</span>
                            }
                            else
                            {
                                <button class="btn-download" @onclick:stopPropagation="true"
                                        @onclick="() => DownloadChapter(chapter)" title="Download for offline">⬇</button>
                            }
                        }
                        <button class="btn-reset-chapter" @onclick:stopPropagation="true"
                                @onclick="() => ResetChapter(chapter.Id)" title="Reset chapter">↺</button>
                    </div>
                }
            </div>
        }

        <div style="display:flex;justify-content:center;padding:.75rem 0 .25rem;border-top:1px solid var(--border);margin-top:.5rem">
            <button class="btn-secondary" style="font-size:.7rem;opacity:.5" @onclick="ResetBook">⚙ Reset All Progress</button>
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired] public int BookId { get; set; }

    private enum DownloadState { None, Downloading, Downloaded }

    private BookDto? _book;
    private string? _coverSrc;
    private bool _showMetaEditor;
    private bool _savingMeta;
    private string _editTitle = "";
    private string _editAuthor = "";
    private string? _editNarrator;
    private int? _editYear;
    private byte[]? _pendingCoverBytes;
    private string? _pendingCoverMime;
    private string? _pendingCoverName;
    private System.Timers.Timer? _longPressTimer;
    private IDownloadService? _downloadSvc;
    private Dictionary<int, DownloadState> _downloadStates = [];
    private bool _downloadingAll;
    private List<ChapterDto> _chapters = [];
    private List<ChapterProgressDto> _chapterProgresses = [];
    private ChapterDto? _currentChapter;
    private double _startPosition;
    private double _currentPosition;

    protected override async Task OnParametersSetAsync()
    {
        _downloadSvc = Services.GetService<IDownloadService>();
        _book = await Api.GetBookAsync(BookId);
        if (_book is null) return;

        _coverSrc = _book.HasCover ? await Api.GetCoverDataUriAsync(_book.Id) : null;

        _chapters = await Api.GetChaptersAsync(BookId);
        _chapterProgresses = await Task.WhenAll(_chapters.Select(c => Api.GetChapterProgressAsync(c.Id)))
            .ContinueWith(t => t.Result.ToList());

        // Load download states
        if (_downloadSvc is not null)
        {
            _downloadStates = [];
            foreach (var ch in _chapters)
                _downloadStates[ch.Id] = await _downloadSvc.IsDownloadedAsync(ch.Id)
                    ? DownloadState.Downloaded : DownloadState.None;
        }

        // Resume the first unlistened chapter, or first chapter
        var resumeIdx = _chapterProgresses.FindIndex(p => !p.IsListened && p.PositionSeconds > 0);
        if (resumeIdx < 0) resumeIdx = _chapterProgresses.FindIndex(p => !p.IsListened);
        if (resumeIdx < 0) resumeIdx = 0;

        if (_chapters.Count > 0)
        {
            _currentChapter = _chapters[resumeIdx];
            _startPosition = _chapterProgresses[resumeIdx].PositionSeconds;
        }
    }

    private async Task SelectChapter(ChapterDto chapter)
    {
        _currentChapter = chapter;
        var idx = _chapters.IndexOf(chapter);
        _startPosition = idx >= 0 ? _chapterProgresses[idx].PositionSeconds : 0;
    }

    private async Task AdvanceChapter()
    {
        if (_currentChapter is null) return;
        var idx = _chapters.FindIndex(c => c.Id == _currentChapter.Id);
        if (idx < _chapters.Count - 1)
        {
            // Mark current as listened
            _chapterProgresses[idx] = _chapterProgresses[idx] with { IsListened = true };
            _currentChapter = _chapters[idx + 1];
            _startPosition = 0;
            StateHasChanged();
        }
    }

    private async Task SaveChapterProgress(double position)
    {
        _currentPosition = position;
        if (_currentChapter is null) return;
        var idx = _chapters.FindIndex(c => c.Id == _currentChapter.Id);
        // We don't know duration here — pass 0, server will check on next update with duration
        await Api.SaveChapterProgressAsync(_currentChapter.Id, position, 0);
        if (idx >= 0)
            _chapterProgresses[idx] = _chapterProgresses[idx] with { PositionSeconds = position };
    }

    private async Task ResetChapter(int chapterId)
    {
        await Api.ResetChapterAsync(chapterId);
        var idx = _chapters.FindIndex(c => c.Id == chapterId);
        if (idx >= 0) _chapterProgresses[idx] = new ChapterProgressDto(0, false);
    }

    private async Task ResetBook()
    {
        await Api.ResetBookAsync(BookId);
        _chapterProgresses = _chapterProgresses.Select(_ => new ChapterProgressDto(0, false)).ToList();
    }

    private void OnCoverTouchStart(EventArgs e)
    {
        _longPressTimer?.Dispose();
        _longPressTimer = new System.Timers.Timer(600);
        _longPressTimer.AutoReset = false;
        _longPressTimer.Elapsed += async (_, _) =>
        {
            _longPressTimer?.Dispose();
            await InvokeAsync(async () =>
            {
                // Load current meta then show editor
                var meta = await Api.GetBookMetaAsync(BookId);
                _editTitle = meta?.Title ?? _book?.Title ?? "";
                _editAuthor = meta?.Author ?? _book?.Author ?? "";
                _editNarrator = meta?.Narrator ?? _book?.Narrator;
                _editYear = meta?.Year ?? _book?.Year;
                _showMetaEditor = true;
                StateHasChanged();
            });
        };
        _longPressTimer.Start();
    }

    private void OnCoverTouchEnd(EventArgs e)
    {
        _longPressTimer?.Dispose();
        _longPressTimer = null;
    }

    private void CloseMetaEditor()
    {
        _showMetaEditor = false;
        _pendingCoverBytes = null;
        _pendingCoverMime = null;
        _pendingCoverName = null;
    }

    private async Task OnCoverFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file is null) return;
        _pendingCoverName = file.Name;
        _pendingCoverMime = file.ContentType;
        using var ms = new MemoryStream();
        await file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024).CopyToAsync(ms);
        _pendingCoverBytes = ms.ToArray();
    }

    private async Task SaveMeta()
    {
        if (_book is null) return;
        _savingMeta = true;

        await Api.SaveBookMetaAsync(BookId, _editTitle, _editAuthor, _editNarrator, null, _editYear);

        if (_pendingCoverBytes is not null)
        {
            await Api.UploadCoverAsync(BookId, _pendingCoverBytes, _pendingCoverMime ?? "image/jpeg");
            _coverSrc = null; // force reload
        }

        _book = await Api.GetBookAsync(BookId);
        if (_book?.HasCover == true)
            _coverSrc = await Api.GetCoverDataUriAsync(_book.Id);

        _savingMeta = false;
        CloseMetaEditor();
        StateHasChanged();
    }





    private async Task DownloadAll()
    {
        if (_downloadSvc is null || _book is null) return;
        _downloadingAll = true;
        StateHasChanged();
        foreach (var chapter in _chapters)
        {
            if (_downloadStates.GetValueOrDefault(chapter.Id) == DownloadState.Downloaded) continue;
            _downloadStates[chapter.Id] = DownloadState.Downloading;
            StateHasChanged();
            try
            {
                await _downloadSvc.DownloadAsync(
                    chapter.Id, _book.Id, _book.Title, chapter.Title,
                    chapter.TrackNumber, Api.GetChapterAudioUrl(chapter.Id));
                _downloadStates[chapter.Id] = DownloadState.Downloaded;
            }
            catch { _downloadStates[chapter.Id] = DownloadState.None; }
            StateHasChanged();
        }
        _downloadingAll = false;
        StateHasChanged();
    }

    private async Task DeleteAllDownloads()
    {
        if (_downloadSvc is null || _book is null) return;
        await _downloadSvc.DeleteBookAsync(_book.Id);
        foreach (var ch in _chapters)
            _downloadStates[ch.Id] = DownloadState.None;
        StateHasChanged();
    }

    private async Task DownloadChapter(ChapterDto chapter)
    {
        if (_downloadSvc is null || _book is null) return;
        _downloadStates[chapter.Id] = DownloadState.Downloading;
        StateHasChanged();
        try
        {
            var url = Api.GetChapterAudioUrl(chapter.Id);
            await _downloadSvc.DownloadAsync(
                chapter.Id, _book.Id, _book.Title, chapter.Title,
                chapter.TrackNumber, url);
            _downloadStates[chapter.Id] = DownloadState.Downloaded;
        }
        catch
        {
            _downloadStates[chapter.Id] = DownloadState.None;
        }
        StateHasChanged();
    }

    private async Task DeleteDownload(int chapterId)
    {
        if (_downloadSvc is null) return;
        await _downloadSvc.DeleteChapterAsync(chapterId);
        _downloadStates[chapterId] = DownloadState.None;
        StateHasChanged();
    }

    private static string FormatTime(double s)
    {
        var ts = TimeSpan.FromSeconds(s);
        return ts.Hours > 0 ? $"{ts.Hours}:{ts.Minutes:D2}:{ts.Seconds:D2}" : $"{ts.Minutes}:{ts.Seconds:D2}";
    }
}
