@inject ApiClient Api
@inject NavigationManager Nav

@if (_book is null)
{
    <div class="loading">Consulting the archive...</div>
}
else
{
    <div class="book-player-page">
        <button class="btn-back" @onclick='() => Nav.NavigateTo("/")'>Library</button>

        <div class="book-header">
            @if (_book.HasCover)
            {
                <img class="book-cover-large" src="@Api.GetCoverUrl(_book.Id)" alt="@_book.Title" />
            }
            <div class="book-info">
                <h1>@_book.Title</h1>
                <h2>@_book.Author</h2>
                @if (_book.Narrator is not null)
                {
                    <p class="narrator">@_book.Narrator</p>
                }
                <button class="btn-secondary" style="margin-top:.5rem;font-size:.7rem"
                        @onclick="ResetBook" title="Reset all chapters">⚙ Reset All</button>
            </div>
        </div>

        @if (_currentChapter is not null)
        {
            <AudioPlayer @key="_currentChapter.Id"
                         Src="@Api.GetChapterAudioUrl(_currentChapter.Id)"
                         BookTitle="@_currentChapter.Title"
                         StartPosition="@_startPosition"
                         OnProgressChanged="SaveChapterProgress"
                         OnChapterEnded="AdvanceChapter"
                         OnBookmarkRequested="AddBookmark" />
        }

        @if (_chapters.Count > 0)
        {
            <div class="chapter-list">
                <div class="chapter-list-header">
                    <h3>Chapters</h3>
                </div>
                @foreach (var (chapter, progress) in _chapters.Zip(_chapterProgresses))
                {
                    var isCurrent = chapter.Id == _currentChapter?.Id;
                    <div class="chapter-item @(isCurrent ? "chapter-active" : "") @(progress.IsListened ? "chapter-listened" : "")"
                         @onclick="() => SelectChapter(chapter)">
                        <span class="chapter-number">@chapter.TrackNumber</span>
                        <span class="chapter-title">@chapter.Title</span>
                        <span class="chapter-status">
                            @if (progress.IsListened)
                            {
                                <span class="listened-badge" title="Listened">✓</span>
                            }
                            else if (progress.PositionSeconds > 0)
                            {
                                <span class="in-progress-badge" title="In progress">…</span>
                            }
                            @if (isCurrent)
                            {
                                <span class="playing-badge">▶</span>
                            }
                        </span>
                        <button class="btn-reset-chapter" @onclick:stopPropagation="true"
                                @onclick="() => ResetChapter(chapter.Id)" title="Reset chapter">↺</button>
                    </div>
                }
            </div>
        }

        @if (_bookmarks.Count > 0)
        {
            <div class="bookmarks">
                <h3>Bookmarks</h3>
                @foreach (var bm in _bookmarks)
                {
                    <div class="bookmark-item">
                        <span>@FormatTime(bm.PositionSeconds) — @(bm.Label ?? "Bookmark")</span>
                        <button class="btn-icon" @onclick="() => DeleteBookmark(bm.Id)">✕</button>
                    </div>
                }
            </div>
        }

        @if (_showBookmarkInput)
        {
            <div class="bookmark-input">
                <input @bind="_bookmarkLabel" placeholder="Label (optional)" />
                <button class="btn-primary" @onclick="ConfirmBookmark">Save</button>
                <button class="btn-secondary" @onclick="() => _showBookmarkInput = false">Cancel</button>
            </div>
        }
    </div>
}

@code {
    [Parameter, EditorRequired] public int BookId { get; set; }

    private BookDto? _book;
    private List<ChapterDto> _chapters = [];
    private List<ChapterProgressDto> _chapterProgresses = [];
    private ChapterDto? _currentChapter;
    private double _startPosition;
    private List<BookmarkDto> _bookmarks = [];
    private bool _showBookmarkInput;
    private string _bookmarkLabel = "";
    private double _currentPosition;

    protected override async Task OnParametersSetAsync()
    {
        _book = await Api.GetBookAsync(BookId);
        if (_book is null) return;

        _chapters = await Api.GetChaptersAsync(BookId);
        _chapterProgresses = await Task.WhenAll(_chapters.Select(c => Api.GetChapterProgressAsync(c.Id)))
            .ContinueWith(t => t.Result.ToList());
        _bookmarks = await Api.GetBookmarksAsync(BookId);

        // Resume the first unlistened chapter, or first chapter
        var resumeIdx = _chapterProgresses.FindIndex(p => !p.IsListened && p.PositionSeconds > 0);
        if (resumeIdx < 0) resumeIdx = _chapterProgresses.FindIndex(p => !p.IsListened);
        if (resumeIdx < 0) resumeIdx = 0;

        if (_chapters.Count > 0)
        {
            _currentChapter = _chapters[resumeIdx];
            _startPosition = _chapterProgresses[resumeIdx].PositionSeconds;
        }
    }

    private async Task SelectChapter(ChapterDto chapter)
    {
        _currentChapter = chapter;
        var idx = _chapters.IndexOf(chapter);
        _startPosition = idx >= 0 ? _chapterProgresses[idx].PositionSeconds : 0;
    }

    private async Task AdvanceChapter()
    {
        if (_currentChapter is null) return;
        var idx = _chapters.FindIndex(c => c.Id == _currentChapter.Id);
        if (idx < _chapters.Count - 1)
        {
            // Mark current as listened
            _chapterProgresses[idx] = _chapterProgresses[idx] with { IsListened = true };
            _currentChapter = _chapters[idx + 1];
            _startPosition = 0;
            StateHasChanged();
        }
    }

    private async Task SaveChapterProgress(double position)
    {
        _currentPosition = position;
        if (_currentChapter is null) return;
        var idx = _chapters.FindIndex(c => c.Id == _currentChapter.Id);
        // We don't know duration here — pass 0, server will check on next update with duration
        await Api.SaveChapterProgressAsync(_currentChapter.Id, position, 0);
        if (idx >= 0)
            _chapterProgresses[idx] = _chapterProgresses[idx] with { PositionSeconds = position };
    }

    private async Task ResetChapter(int chapterId)
    {
        await Api.ResetChapterAsync(chapterId);
        var idx = _chapters.FindIndex(c => c.Id == chapterId);
        if (idx >= 0) _chapterProgresses[idx] = new ChapterProgressDto(0, false);
    }

    private async Task ResetBook()
    {
        await Api.ResetBookAsync(BookId);
        _chapterProgresses = _chapterProgresses.Select(_ => new ChapterProgressDto(0, false)).ToList();
    }

    private void AddBookmark() { _showBookmarkInput = true; _bookmarkLabel = ""; }

    private async Task ConfirmBookmark()
    {
        var bm = await Api.AddBookmarkAsync(BookId, _currentPosition,
            string.IsNullOrWhiteSpace(_bookmarkLabel) ? null : _bookmarkLabel);
        if (bm is not null) _bookmarks.Add(bm);
        _showBookmarkInput = false;
    }

    private async Task DeleteBookmark(int id)
    {
        await Api.DeleteBookmarkAsync(id);
        _bookmarks.RemoveAll(b => b.Id == id);
    }

    private static string FormatTime(double s)
    {
        var ts = TimeSpan.FromSeconds(s);
        return ts.Hours > 0 ? $"{ts.Hours}:{ts.Minutes:D2}:{ts.Seconds:D2}" : $"{ts.Minutes}:{ts.Seconds:D2}";
    }
}
