@inject ApiClient Api
@inject NavigationManager Nav
@inject IServiceProvider Services
@using Microsoft.Extensions.DependencyInjection

<div class="library-browser">

    
    <div class="library-top">
        <div style="display:flex;align-items:center;gap:.6rem;margin-bottom:.6rem">
            <button class="btn-icon" @onclick='() => Nav.NavigateTo("/")' title="Home" style="font-size:1.3rem;padding:.3rem .5rem">⌂</button>
            <input type="search" placeholder="Query the archive..." class="search-input"
                   value="@_search" @oninput="OnSearch" />
        </div>

        <div class="library-controls">
            <div class="sort-group">
                <span class="control-label">Sort</span>
                <button class="@ChipClass(_sort,"name")"   @onclick='() => SetSort("name")'>Name</button>
                <button class="@ChipClass(_sort,"date")"   @onclick='() => SetSort("date")'>Added</button>
                <button class="@ChipClass(_sort,"progress")" @onclick='() => SetSort("progress")'>Progress</button>
            </div>
            <div class="sort-group">
                <span class="control-label">Show</span>
                <button class="@ChipClass(_filter,"all")"        @onclick='() => SetFilter("all")'>All</button>
                <button class="@ChipClass(_filter,"inprogress")" @onclick='() => SetFilter("inprogress")'>In Progress</button>
                <button class="@ChipClass(_filter,"completed")"  @onclick='() => SetFilter("completed")'>Done</button>
            </div>
        </div>
    </div>

    
    @if (_loading)
    {
        <div class="loading">Consulting the archive...</div>
    }
    else if (_error is not null)
    {
        <div class="empty-state"><p>The pneumatic tubes have failed: @_error</p></div>
    }
    else if (!FilteredBooks.Any())
    {
        <div class="empty-state">
            <p>@(_books.Count == 0 ? "The archive lies empty, traveller." : "No volumes match this filter.")</p>
        </div>
    }
    else
    {
        <div class="book-grid">
            @foreach (var book in FilteredBooks)
            {
                <BookCard Book="book" />
            }
        </div>
    }

    

</div>

@code {
    private List<BookDto> _books = [];
    private string _search = "";
    private string _sort = "name";
    private string _filter = "all";
    private string? _error;
    private bool _loading = true;
    private bool _scanning;

    private bool _hasDownloads;

    private string ChipClass(string current, string value) =>
        $"chip{(current == value ? " chip-active" : "")}";

    private void SetSort(string s) { _sort = s; }
    private void SetFilter(string f) { _filter = f; }

    private IEnumerable<BookDto> FilteredBooks
    {
        get
        {
            var q = _books.AsEnumerable();

            // Client-side search
            if (!string.IsNullOrWhiteSpace(_search))
            {
                var s = _search.ToLowerInvariant();
                q = q.Where(b =>
                    b.Title.ToLowerInvariant().Contains(s) ||
                    b.Author.ToLowerInvariant().Contains(s) ||
                    (b.Narrator?.ToLowerInvariant().Contains(s) ?? false));
            }

            q = _filter switch
            {
                "inprogress" => q.Where(b => b.IsInProgress),
                "completed"  => q.Where(b => b.IsCompleted),
                _            => q
            };

            return _sort switch
            {
                "date"     => q.OrderByDescending(b => b.AddedAt),
                "progress" => q.OrderByDescending(b => b.IsInProgress)
                               .ThenByDescending(b => b.IsCompleted)
                               .ThenBy(b => b.Title),
                _          => q.OrderBy(b => b.Title)
            };
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadBooks();
        var dl = Services?.GetService<IDownloadService>();
        if (dl is not null)
            _hasDownloads = (await dl.GetTotalSizeAsync()) > 0;
    }

    private async Task LoadBooks()
    {
        _loading = true;
        _error = null;
        try { _books = await Api.GetBooksAsync(); }
        catch (Exception ex) { _error = ex.Message; }
        _loading = false;
    }

    private void OnSearch(ChangeEventArgs e) =>
        _search = e.Value?.ToString() ?? "";

    private async Task ScanLibrary()
    {
        _scanning = true;
        await Api.ScanLibraryAsync();
        await LoadBooks();
        _scanning = false;
    }

}
