@inject ApiClient Api
@inject NavigationManager Nav
@inject IServiceProvider Services
@using Microsoft.Extensions.DependencyInjection

<div class="library-browser">
    <div class="library-header">
        <div style="display:flex;align-items:center;gap:.75rem">
            <button class="btn-icon" @onclick='() => Nav.NavigateTo("/")' title="Home" style="font-size:1.3rem;padding:.3rem .5rem">⌂</button>
            <h1>The Archive</h1>
        </div>
        <div class="library-toolbar">
            <input type="search" placeholder="Query the archive..." class="search-input"
                   value="@_search" @oninput="OnSearch" />
            <button class="btn-secondary" @onclick="ScanLibrary" disabled="@_scanning">
                @(_scanning ? "⚙ Cataloguing..." : "⚙ Catalogue")
            </button>
            <button class="btn-secondary" @onclick="EnrichLibrary" disabled="@_enriching">
                @(_enriching ? "⚙ Fetching..." : "⚙ Fetch Covers")
            </button>
            @if (_hasDownloads)
            {
                <button class="btn-secondary" @onclick='() => Nav.NavigateTo("/downloads")' title="Downloads">⬇ Downloads</button>
            }
        </div>
    </div>

    @if (_loading)
    {
        <div class="loading">Consulting the archive...</div>
    }
    else if (_error is not null)
    {
        <div class="empty-state">
            <p>The pneumatic tubes have failed: @_error</p>
        </div>
    }
    else if (_books.Count == 0)
    {
        <div class="empty-state">
            <p>The archive lies empty, traveller.</p>
            <p>Deposit volumes in the Library vault and engage the Catalogue mechanism.</p>
        </div>
    }
    else
    {
        <div class="book-grid">
            @foreach (var book in _books)
            {
                <BookCard Book="book" />
            }
        </div>
    }
</div>

@code {
    private List<BookDto> _books = [];
    private string _search = "";
    private string? _error;
    private bool _loading = true;
    private bool _scanning;
    private bool _enriching;
    private bool _hasDownloads;
    private System.Timers.Timer? _debounce;

    protected override async Task OnInitializedAsync()
    {
        await LoadBooks();
        var dl = Services?.GetService<IDownloadService>();
        if (dl is not null)
            _hasDownloads = (await dl.GetTotalSizeAsync()) > 0;
    }

    private async Task LoadBooks(string? search = null)
    {
        _loading = true;
        _error = null;
        try
        {
            _books = await Api.GetBooksAsync(search);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        _loading = false;
    }

    private void OnSearch(ChangeEventArgs e)
    {
        _search = e.Value?.ToString() ?? "";
        _debounce?.Dispose();
        _debounce = new System.Timers.Timer(300);
        _debounce.Elapsed += async (_, _) =>
        {
            _debounce?.Dispose();
            await InvokeAsync(async () =>
            {
                await LoadBooks(_search);
                StateHasChanged();
            });
        };
        _debounce.AutoReset = false;
        _debounce.Start();
    }

    private async Task ScanLibrary()
    {
        _scanning = true;
        var added = await Api.ScanLibraryAsync();
        _scanning = false;
        if (added > 0) await LoadBooks(_search);
    }

    private async Task EnrichLibrary()
    {
        _enriching = true;
        await Api.EnrichLibraryAsync();
        _enriching = false;
        await LoadBooks(_search);
    }
}
