@inject IJSRuntime JS
@inject IServiceProvider Services
@inject ApiClient Api
@using Microsoft.Extensions.DependencyInjection
@implements IAsyncDisposable

<div class="audio-player @(_playing ? "audio-player-playing" : "")">
    <span class="player-title">@BookTitle</span>

    @if (!string.IsNullOrEmpty(Src))
    {
        <div class="player-time-display">
            <span class="player-time-current">@FormatTime(CurrentPosition)</span>
            @if (Duration > 0)
            {
                <span class="player-time-sep">/</span>
                <span class="player-time-total">@FormatTime(Duration)</span>
            }
        </div>
    }

    <div class="player-controls">
        <button class="btn-skip" @onclick="SkipBack">⏮<span>30</span></button>
        <button class="btn-play" @onclick="TogglePlay">
            @(_playing ? "⏸" : "▶")
        </button>
        <button class="btn-skip" @onclick="SkipForward"><span>30</span>⏭</button>
    </div>

    @if (Duration > 0)
    {
        <div class="player-progress">
            <input type="range" min="0" max="@((int)Duration)" value="@((int)CurrentPosition)"
                   @onchange="OnSeek" class="progress-bar" />
        </div>
    }

    <div class="player-speed-row">
        <span class="player-speed-label">Speed</span>
        <span class="speed-display"
              @ontouchstart="OnSpeedTouchStart" @ontouchend="OnSpeedTouchEnd" @ontouchmove="OnSpeedTouchEnd"
              @onmousedown="OnSpeedTouchStart" @onmouseup="OnSpeedTouchEnd" @onmouseleave="OnSpeedTouchEnd"
              title="Long press to change speed">@(_speed)×</span>
    </div>

    @if (_showSpeedPicker)
    {
        <div class="speed-picker-overlay" @onclick="() => _showSpeedPicker = false">
            <div class="speed-picker" @onclick:stopPropagation="true">
                @foreach (var s in new[] { 0.75, 1.0, 1.25, 1.5, 2.0 })
                {
                    <button class="speed-option @(Math.Abs(_speed - s) < 0.01 ? "speed-option-active" : "")"
                            @onclick="() => SetSpeed(s)">@s×</button>
                }
            </div>
        </div>
    }

    @if (_nativePlayer is not null)
    {
        <div class="player-footer">
            <span class="player-source-badge @(_nativePlayer.IsPlayingLocally ? "source-local" : "source-stream")">
                @(_nativePlayer.IsPlayingLocally ? "📱 Local" : "📡 Streaming")
            </span>
        </div>
    }
</div>

@* HTML5 audio element — only used when native service is not available *@
@if (_nativePlayer is null)
{
    <audio id="chronicler-audio" @ref="_audioRef" src="@Src" preload="auto" playsinline></audio>
}

@code {
    [Parameter, EditorRequired] public string Src { get; set; } = "";
    [Parameter, EditorRequired] public string BookTitle { get; set; } = "";
    [Parameter] public double StartPosition { get; set; }
    [Parameter] public EventCallback<double> OnProgressChanged { get; set; }
    [Parameter] public EventCallback OnChapterEnded { get; set; }

    private ElementReference _audioRef;
    private DotNetObjectReference<AudioPlayer>? _dotnetRef;
    private IAudioPlayerService? _nativePlayer;
    private bool _playing;
    private bool _jsPlaying;
    private double _speed = 1.0;
    private bool _showSpeedPicker;
    private System.Timers.Timer? _speedLongPress;
    private DateTime _lastSave = DateTime.MinValue;
    private CancellationTokenSource? _pollCts;
    private string _lastSrc = "";
    private bool _hasStartedOnce;

    public double CurrentPosition { get; private set; }
    public double Duration { get; private set; }

    protected override void OnInitialized()
    {
        _nativePlayer = Services.GetService<IAudioPlayerService>();
        if (_nativePlayer is not null)
        {
            _nativePlayer.Ended += OnNativeEnded;
            _pollCts = new CancellationTokenSource();
            _ = PollLoop(_pollCts.Token);
        }
    }

    // Poll player state every 250ms on the Blazor sync context
    private async Task PollLoop(CancellationToken ct)
    {
        while (!ct.IsCancellationRequested)
        {
            try { await Task.Delay(250, ct); } catch { break; }
            await InvokeAsync(async () =>
            {
                if (_nativePlayer is null) return;
                if (_playing) { try { CurrentPosition = _nativePlayer.CurrentPosition; } catch { } }
                try { Duration = _nativePlayer.Duration; } catch { }
                if (_playing && (DateTime.UtcNow - _lastSave).TotalSeconds >= 10)
                {
                    _lastSave = DateTime.UtcNow;
                    try { await OnProgressChanged.InvokeAsync(CurrentPosition); } catch { }
                }
                StateHasChanged();
            });
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _nativePlayer is not null) return;
        _dotnetRef = DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("chroniclerAudio.registerEvents", _audioRef, _dotnetRef);
        if (StartPosition > 0)
            await JS.InvokeVoidAsync("chroniclerAudio.seek", _audioRef, StartPosition);
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!string.IsNullOrEmpty(Src) && Src != _lastSrc)
        {
            _lastSrc = Src;
            _playing = false;
            _hasStartedOnce = false;
            CurrentPosition = StartPosition;
        }
    }

    private async Task TogglePlay()
    {
        if (_nativePlayer is not null)
        {
            if (_playing)
            {
                _playing = false;
                await _nativePlayer.PauseAsync();
                await OnProgressChanged.InvokeAsync(CurrentPosition);
            }
            else
            {
                _playing = true;
                await _nativePlayer.PlayAsync(Src);
                if (!_hasStartedOnce && StartPosition > 1)
                {
                    await Api.DiagAsync($"Resuming chapter at {StartPosition:F1}s — {Src}");
                    await _nativePlayer.SeekAsync(StartPosition);
                }
                else
                {
                    await Api.DiagAsync($"Starting chapter from beginning — {Src}");
                }
                _hasStartedOnce = true;
            }
        }
        else
        {
            if (_jsPlaying)
                await JS.InvokeVoidAsync("chroniclerAudio.pause", _audioRef);
            else
                await JS.InvokeVoidAsync("chroniclerAudio.play", _audioRef);
        }
    }

    private async Task SkipBack()
    {
        var pos = Math.Max(0, CurrentPosition - 30);
        if (_nativePlayer is not null) await _nativePlayer.SeekAsync(pos);
        else await JS.InvokeVoidAsync("chroniclerAudio.seek", _audioRef, pos);
    }

    private async Task SkipForward()
    {
        var pos = Math.Min(Duration, CurrentPosition + 30);
        if (_nativePlayer is not null) await _nativePlayer.SeekAsync(pos);
        else await JS.InvokeVoidAsync("chroniclerAudio.seek", _audioRef, pos);
    }

    private async Task OnSeek(ChangeEventArgs e)
    {
        if (!double.TryParse(e.Value?.ToString(), out var pos)) return;
        if (_nativePlayer is not null) await _nativePlayer.SeekAsync(pos);
        else await JS.InvokeVoidAsync("chroniclerAudio.seek", _audioRef, pos);
    }

    private void OnNativeEnded()
    {
        _playing = false;
        InvokeAsync(async () => { StateHasChanged(); await OnChapterEnded.InvokeAsync(); });
    }

    // ── JS callbacks ──────────────────────────────────────────────────────────

    [JSInvokable] public void OnJsPlay()  { _playing = true;  _jsPlaying = true;  InvokeAsync(StateHasChanged); }
    [JSInvokable] public void OnJsPause() { _playing = false; _jsPlaying = false; InvokeAsync(StateHasChanged); }
    [JSInvokable] public void OnJsMetadata(double duration) { Duration = duration; InvokeAsync(StateHasChanged); }
    [JSInvokable] public void OnJsEnded() { _playing = false; _jsPlaying = false; InvokeAsync(async () => { StateHasChanged(); await OnChapterEnded.InvokeAsync(); }); }

    [JSInvokable]
    public async Task OnJsTimeUpdate(double currentTime)
    {
        CurrentPosition = currentTime;
        if ((DateTime.UtcNow - _lastSave).TotalSeconds >= 10)
        {
            _lastSave = DateTime.UtcNow;
            await OnProgressChanged.InvokeAsync(CurrentPosition);
        }
        await InvokeAsync(StateHasChanged);
    }

    private void OnSpeedTouchStart(EventArgs e)
    {
        _speedLongPress?.Dispose();
        _speedLongPress = new System.Timers.Timer(600) { AutoReset = false };
        _speedLongPress.Elapsed += (_, _) => InvokeAsync(() => { _showSpeedPicker = true; StateHasChanged(); });
        _speedLongPress.Start();
    }

    private void OnSpeedTouchEnd(EventArgs e)
    {
        _speedLongPress?.Dispose();
        _speedLongPress = null;
    }

    private async Task SetSpeed(double speed)
    {
        _speed = speed;
        _showSpeedPicker = false;
        if (_nativePlayer is not null) await _nativePlayer.SetRateAsync(speed);
        else await JS.InvokeVoidAsync("chroniclerAudio.setRate", _audioRef, speed);
    }

    private static string FormatTime(double s)
    {
        var ts = TimeSpan.FromSeconds(s);
        return ts.Hours > 0 ? $"{ts.Hours}:{ts.Minutes:D2}:{ts.Seconds:D2}" : $"{ts.Minutes}:{ts.Seconds:D2}";
    }

    public async ValueTask DisposeAsync()
    {
        _pollCts?.Cancel();
        _pollCts?.Dispose();
        if (_nativePlayer is not null)
        {
            _nativePlayer.Ended -= OnNativeEnded;
            if (_playing) await _nativePlayer.PauseAsync();
        }
        else
        {
            _dotnetRef?.Dispose();
            try { await JS.InvokeVoidAsync("chroniclerAudio.pause", _audioRef); } catch { }
        }
    }
}
