@inject NavigationManager Nav
@inject ApiClient Api

<div class="book-card @(_isFavorite ? "book-card-favorite" : "")"
     @onclick="OnClick"
     @ontouchstart="OnTouchStart" @ontouchend="OnTouchEnd" @ontouchmove="OnTouchEnd"
     @onmousedown="OnTouchStart" @onmouseup="OnTouchEnd" @onmouseleave="OnTouchEnd">
    @if (_isFavorite)
    {
        <span class="book-favorite-badge">★</span>
    }
    <div class="book-cover">
        @if (_coverSrc is not null)
        {
            <img src="@_coverSrc" alt="@Book.Title" />
        }
        else if (Book.HasCover)
        {
            <div class="book-cover-placeholder" style="opacity:.15">⚙</div>
        }
        else
        {
            <div class="book-cover-placeholder">📚</div>
        }
    </div>
    <div class="book-meta">
        <span class="book-title">@Book.Title</span>
        <span class="book-author">@Book.Author</span>
        @if (Book.Narrator is not null)
        {
            <span class="book-narrator">@Book.Narrator</span>
        }
    </div>
</div>

@if (_showMenu)
{
    <div class="book-card-menu-overlay" @onclick="CloseMenu">
        <div class="book-card-menu" @onclick:stopPropagation="true">
            <div class="book-card-menu-title">@Book.Title</div>
            <button class="book-card-menu-item" @onclick="ToggleFavorite">
                @(_isFavorite ? "★ Remove from Favorites" : "☆ Add to Favorites")
            </button>
            <button class="book-card-menu-item" @onclick="NavigateFromMenu">
                ▶ Open Book
            </button>
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired] public BookDto Book { get; set; } = null!;
    [Parameter] public EventCallback OnFavoriteChanged { get; set; }

    private int _loadedBookId = -1;
    private string? _coverSrc;
    private bool _isFavorite;
    private bool _showMenu;
    private System.Timers.Timer? _longPress;
    private bool _longPressTriggered;

    protected override async Task OnParametersSetAsync()
    {
        if (Book.Id == _loadedBookId) return;

        _loadedBookId = Book.Id;
        _coverSrc = null;
        _isFavorite = Book.IsFavorite;

        if (Book.HasCover)
        {
            var bookId = Book.Id;
            var src = await Api.GetCoverDataUriAsync(bookId);
            if (_loadedBookId == bookId)
                _coverSrc = src;
        }
    }

    private void OnTouchStart(EventArgs e)
    {
        _longPressTriggered = false;
        _longPress?.Dispose();
        _longPress = new System.Timers.Timer(600) { AutoReset = false };
        _longPress.Elapsed += (_, _) => InvokeAsync(() =>
        {
            _longPressTriggered = true;
            _showMenu = true;
            StateHasChanged();
        });
        _longPress.Start();
    }

    private void OnTouchEnd(EventArgs e)
    {
        _longPress?.Dispose();
        _longPress = null;
    }

    private void OnClick()
    {
        if (_longPressTriggered) return;
        Nav.NavigateTo($"/book/{Book.Id}");
    }

    private void CloseMenu() => _showMenu = false;

    private void NavigateFromMenu()
    {
        _showMenu = false;
        Nav.NavigateTo($"/book/{Book.Id}");
    }

    private async Task ToggleFavorite()
    {
        // Close menu and optimistically update UI immediately
        _isFavorite = !_isFavorite;
        _showMenu = false;
        StateHasChanged();
        try
        {
            await Api.ToggleFavoriteAsync(Book.Id);
            await OnFavoriteChanged.InvokeAsync();
        }
        catch { _isFavorite = !_isFavorite; StateHasChanged(); }
    }
}
