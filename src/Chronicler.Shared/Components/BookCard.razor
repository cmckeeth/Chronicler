@inject NavigationManager Nav
@inject ApiClient Api

<div class="book-card @(Book.IsFavorite ? "book-card-favorite" : "")" @onclick="Navigate">
    <button class="btn-favorite @(Book.IsFavorite ? "btn-favorite-active" : "")"
            @onclick:stopPropagation="true" @onclick="ToggleFavorite">★</button>
    <div class="book-cover">
        @if (_coverSrc is not null)
        {
            <img src="@_coverSrc" alt="@Book.Title" />
        }
        else if (Book.HasCover)
        {
            <div class="book-cover-placeholder" style="opacity:.15">⚙</div>
        }
        else
        {
            <div class="book-cover-placeholder">📚</div>
        }
    </div>
    <div class="book-meta">
        <span class="book-title">@Book.Title</span>
        <span class="book-author">@Book.Author</span>
        @if (Book.Narrator is not null)
        {
            <span class="book-narrator">@Book.Narrator</span>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public BookDto Book { get; set; } = null!;

    private int _loadedBookId = -1;
    private string? _coverSrc;

    protected override async Task OnParametersSetAsync()
    {
        if (Book.Id == _loadedBookId) return;

        _loadedBookId = Book.Id;
        _coverSrc = null;

        if (Book.HasCover)
        {
            var bookId = Book.Id;
            var src = await Api.GetCoverDataUriAsync(bookId);
            // Discard if the book changed while we were loading
            if (_loadedBookId == bookId)
                _coverSrc = src;
        }
    }

    private void Navigate() => Nav.NavigateTo($"/book/{Book.Id}");

    private async Task ToggleFavorite()
    {
        var newVal = await Api.ToggleFavoriteAsync(Book.Id);
        Book = Book with { IsFavorite = newVal };
        StateHasChanged();
    }
}
