<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=Cinzel+Decorative:wght@400;700;900&family=Cinzel:wght@400;600;700&family=Lora:ital,wght@0,400;0,600;1,400;1,600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["Chronicler.Web.styles.css"]" />
    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet />
</head>

<body>
    <!-- Auth redirect before Blazor connects — avoids blank screen on new devices -->
    <script>
        (function () {
            var token = localStorage.getItem('chronicler_token');
            var onLogin = window.location.pathname === '/login';
            if (!token && !onLogin) window.location.replace('/login');
        })();
    </script>

    <Routes />
    <script src="_framework/blazor.web.js"></script>
    <script src="_content/Chronicler.Shared/chronicler.js"></script>
</body>

</html>
