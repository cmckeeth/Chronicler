@inject ApiClient Api
@implements IDisposable

<div class="status-bar">
    <span class="status-indicator @(_connected ? "status-online" : "status-offline")"></span>
    <span class="status-version">v@(AppInfo.VersionString)</span>
    @if (_updateAvailable && _isAndroid)
    {
        <span class="status-update" @onclick="DownloadUpdate">
            ⚡ v@_latestVersion available — tap to install
        </span>
    }
    else if (_connected)
    {
        <span class="status-text">Connected</span>
    }
    else
    {
        <span class="status-text">Server unreachable</span>
    }
</div>

@code {
    private bool _connected;
    private bool _updateAvailable;
    private string? _latestVersion;
    private PeriodicTimer? _timer;
    private static readonly bool _isAndroid = DeviceInfo.Platform == DevicePlatform.Android;

    protected override async Task OnInitializedAsync()
    {
        await Check();
        _timer = new PeriodicTimer(TimeSpan.FromSeconds(10));
        _ = PollAsync();
    }

    private async Task PollAsync()
    {
        while (_timer is not null && await _timer.WaitForNextTickAsync())
        {
            await Check();
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task Check()
    {
        try
        {
            var latest = await Api.GetLatestVersionAsync();
            _connected = latest is not null;
            if (latest is not null && latest != "0.0.0" &&
                Version.TryParse(latest, out var latestVer) &&
                Version.TryParse(AppInfo.VersionString, out var currentVer) &&
                latestVer > currentVer)
            {
                _updateAvailable = true;
                _latestVersion = latest;
            }
        }
        catch
        {
            _connected = false;
        }
    }

    private async Task DownloadUpdate()
    {
        var url = _latestVersion is not null
            ? $"{ApiConfig.BaseUrl}/api/update/apk/Chronicler-v{_latestVersion}.apk"
            : ApiConfig.UpdateApkUrl;
        await Launcher.OpenAsync(new Uri(url));
    }

    public void Dispose() => _timer?.Dispose();
}
