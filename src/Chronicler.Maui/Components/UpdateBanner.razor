@inject ApiClient Api
@implements IDisposable

@if (_updateAvailable)
{
    <div class="update-modal-overlay" @onclick="Dismiss">
        <div class="update-modal" @onclick:stopPropagation="true">
            <div class="update-modal-title">⚙ Update Available</div>
            <div class="update-modal-body">
                Version <strong>@_latestVersion</strong> is ready to install.
            </div>
            <div class="update-modal-actions">
                <button class="btn-primary" @onclick="DownloadUpdate">Download</button>
                <button class="btn-secondary" @onclick="Dismiss">Later</button>
            </div>
        </div>
    </div>
}

@code {
    private bool _updateAvailable;
    private string? _latestVersion;
    private CancellationTokenSource _cts = new();

    protected override async Task OnInitializedAsync()
    {
        // Check once on startup after a short delay
        try
        {
            await Task.Delay(2000, _cts.Token);
            await CheckUpdate();
        }
        catch (OperationCanceledException) { }
    }

    private async Task CheckUpdate()
    {
        var latest = await Api.GetLatestVersionAsync();
        if (latest is null || latest == "0.0.0") return;

        var current = AppInfo.VersionString;
        if (Version.TryParse(latest, out var latestVer) &&
            Version.TryParse(current, out var currentVer) &&
            latestVer > currentVer)
        {
            _latestVersion = latest;
            _updateAvailable = true;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task DownloadUpdate()
    {
        // Always download latest — no version in URL needed
        await Launcher.OpenAsync(new Uri(ApiConfig.UpdateApkUrl));
        Dismiss();
    }

    private void Dismiss()
    {
        _updateAvailable = false;
        StateHasChanged();
    }

    public void Dispose() => _cts.Cancel();
}
