@page "/"
@inject NavigationManager Nav
@inject AuthState Auth
@inject ITokenStorage TokenStorage
@inject ApiClient Api

@if (!Auth.IsAuthenticated)
{
    Nav.NavigateTo("/login");
}
else
{
    <div class="landing-page">
        <span class="landing-corner tl">⚙</span>
        <span class="landing-corner tr">⚙</span>
        <span class="landing-corner bl">⚙</span>
        <span class="landing-corner br">⚙</span>
        <div style="flex:1"></div>

        <div class="landing-top">
            <h1 class="landing-title">Chronicler</h1>
            <p class="landing-subtitle">Your Audiobook Library</p>
            <div class="landing-ornament">⚙ ───────── ⚙</div>
        </div>
        <div style="position:absolute;top:1rem;right:1rem">
            <button class="btn-secondary" style="font-size:.65rem;opacity:.5" @onclick="SignOut">Sign Out</button>
        </div>

        <div class="landing-middle">
            <button class="landing-enter-btn" @onclick="EnterArchive">
                <img src="logo.png" class="landing-enter-logo" alt="" />
                <span class="landing-enter-text">Enter the Archive</span>
                <span class="landing-enter-sub">Browse your collection</span>
            </button>
        </div>

        <div style="flex:1.2"></div>

        <div style="width:100%">
            <UpdateBanner />
        </div>
    </div>
}

@code {
    private async Task EnterArchive()
    {
        // If server is unreachable, go straight to downloads
        var version = await Api.GetLatestVersionAsync();
        if (version is null)
            Nav.NavigateTo("/downloads");
        else
            Nav.NavigateTo("/archive");
    }

    private async Task SignOut()
    {
        await TokenStorage.ClearAsync();
        Auth.Clear();
        Nav.NavigateTo("/login");
    }
}
