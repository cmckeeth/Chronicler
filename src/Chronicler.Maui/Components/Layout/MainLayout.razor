@inherits LayoutComponentBase
@inject AuthState Auth
@inject NavigationManager Nav

<AuthInitializer />

<div class="maui-layout">
    @if (Auth.IsAuthenticated)
    {
        <UpdateBanner />
    }
    <main class="maui-content">
        @if (Auth.IsAuthenticated || Nav.Uri.Contains("/login"))
        {
            @Body
        }
    </main>
</div>
