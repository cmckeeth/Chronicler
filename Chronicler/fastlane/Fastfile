default_platform(:ios)

# Build the native Swift app and push it to TestFlight.
# Auth uses an App Store Connect API key (no Apple-ID password / 2FA prompts), supplied
# via env vars so nothing secret lives in the repo:
#   ASC_KEY_ID      – the key's Key ID
#   ASC_ISSUER_ID   – the API Issuer ID
#   ASC_KEY_PATH    – absolute path to the downloaded AuthKey_XXXXXX.p8
#   APPLE_TEAM_ID   – Developer Portal Team ID (see Appfile)
platform :ios do
  desc "Build and upload a new build to TestFlight"
  lane :beta do
    # Version is derived, never stored in the project: major.minor from the
    # repo-root VERSION file, patch from the git commit count — the same formula
    # deploy.sh uses for Android and the web, so all three report one number.
    # MARKETING_VERSION in project.pbxproj was hand-edited and went stale (three
    # different builds all shipped as "3.2.6", which made tester reports useless);
    # overriding it here means it can't drift again.
    base_version = File.read(File.join(File.expand_path("../..", __dir__), "VERSION")).strip
    app_version = "#{base_version}.#{number_of_commits}"
    UI.message("Shipping version #{app_version} (build #{number_of_commits})")
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: ENV.fetch("ASC_KEY_PATH")
    )

    build_app(
      project: "Chronicler.xcodeproj",
      scheme: "Chronicler",
      export_method: "app-store",
      export_options: { signingStyle: "automatic" },
      # Unique, monotonic build number from git history — no agvtool/project edits needed.
      # -allowProvisioningUpdates lets Xcode mint the App Store distribution profile on the fly.
      xcargs: "CURRENT_PROJECT_VERSION=#{number_of_commits} MARKETING_VERSION=#{app_version} -allowProvisioningUpdates",
      export_xcargs: "-allowProvisioningUpdates"
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end
